# Copy thành .env và điền giá trị thật:  cp .env.example .env
# Kênh thuyết minh (/v1/describe) — lấy tại https://aistudio.google.com/apikey
# Kênh cảnh báo KHÔNG cần key này (chạy hoàn toàn local).
GEMINI_API_KEY=
# Có thể override; mặc định trong code là gemini-3.5-flash-lite.
DESCRIBE_MODEL=gemini-3.5-flash-lite
